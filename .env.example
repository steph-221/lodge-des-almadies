# Administration (/admin)
ADMIN_PASSWORD=
SESSION_SECRET=            # 16 caractères minimum, aléatoire

# Stockage du contenu et des photos en production (Vercel > Storage > Blob)
BLOB_READ_WRITE_TOKEN=

# Formulaire de contact : Cloudflare Turnstile (gratuit) + envoi par Resend
PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
RESEND_API_KEY=
CONTACT_FROM=              # ex. Lodge des Almadies <site@lodgedesalmadies.com> (domaine vérifié chez Resend)

# Octorate : le lien de réservation se règle dans /admin > Réglages (aucune clé API dans le code)
