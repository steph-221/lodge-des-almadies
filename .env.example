# Administration (/admin)
ADMIN_PASSWORD=            # accès de secours de la direction (sans identifiant)
SESSION_SECRET=            # 16 caractères minimum, aléatoire

# Espace Services hôtel : base Neon (projet dédié au Lodge, région Francfort)
DATABASE_URL=              # chaîne poolée (utilisée par le site)
DATABASE_URL_UNPOOLED=     # chaîne directe (utilisée par db/migrate.mjs)
STAFF_PEPPER=              # aléatoire, 32 caractères minimum ; mélangé aux codes du personnel avant hachage
CRON_SECRET=               # aléatoire, 16 caractères minimum ; protège /api/cron/* (brief quotidien, sauvegarde)
PUBLIC_APP_ORIGIN=         # adresse stable de l'app (liens des e-mails et QR codes), ex. https://app.lodgedesalmadies.com

# Stockage du contenu et des photos du site en production (Vercel > Storage > Blob)
BLOB_READ_WRITE_TOKEN=

# Formulaire de contact : Cloudflare Turnstile (gratuit) + envoi par Resend
PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
RESEND_API_KEY=
CONTACT_FROM=              # ex. Lodge des Almadies <site@lodgedesalmadies.com> (domaine vérifié chez Resend)

# Lots suivants (noms prévus, à renseigner à la livraison du lot concerné)
# Google Drive (lot 1c) : GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN, GOOGLE_DRIVE_ROOT_FOLDER_ID
# Lecture des fiches (lot 5) : ANTHROPIC_API_KEY

# Octorate : le lien de réservation se règle dans /admin > Réglages (aucune clé API dans le code)
