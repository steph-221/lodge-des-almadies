---
import '../styles/global.css';
import BookButton from '../components/BookButton.astro';
import { getContent, imgSrc } from '../lib/content';
interface Props { title: string; description?: string; schema?: object[]; noindex?: boolean; }
const c = await getContent();
const { site } = c;
const nav = c.nav as { href: string; label: string; children?: { href: string; label: string }[] }[];
const footerNav = nav.flatMap((n) => [n, ...(n.children ?? [])]).filter((n, i, a) => a.findIndex((m) => m.href === n.href) === i);
const { title, description = `${site.name} : hôtel 3 étoiles aux Almadies, Dakar. Chambres, restaurant, piscine et salle de séminaire.`, schema = [], noindex = false } = Astro.props;
const path = Astro.url.pathname;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  '@id': 'https://lodgedesalmadies.com/#hotel',
  name: site.name,
  description: 'Hôtel 3 étoiles de 36 chambres aux Almadies, Dakar, avec restaurant, piscine, salle de séminaire et boutiques.',
  telephone: site.phone,
  email: site.email,
  url: 'https://lodgedesalmadies.com',
  image: 'https://lodgedesalmadies.com/img/hotel.jpg',
  logo: 'https://lodgedesalmadies.com/img/logo.png',
  starRating: { '@type': 'Rating', ratingValue: '3' },
  numberOfRooms: 36,
  inLanguage: 'fr',
  currenciesAccepted: 'XOF, EUR, USD',
  paymentAccepted: 'Espèces, Visa, Mastercard',
  sameAs: [site.tripadvisor, site.maps],
  hasMap: site.maps,
  geo: { '@type': 'GeoCoordinates', latitude: 14.7399266, longitude: -17.5150638 },
  address: { '@type': 'PostalAddress', streetAddress: 'Route de l’OCI', addressLocality: 'Dakar', addressCountry: 'SN' },
  amenityFeature: ['Piscine', 'Restaurant', 'Bar', 'Wi-Fi gratuit', 'Réception 24h/24', 'Parking', 'Groupe électrogène', 'Salle de séminaire'].map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
};
const graph = [jsonLd, ...schema];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://lodgedesalmadies.com/img/hotel.jpg" />
  <meta property="og:locale" content="fr_FR" />
  <link rel="icon" href="/img/logo.png" />
  <meta name="theme-color" content="#faf7f2" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
</head>
<body>
  <a class="skip" href="#main">Aller au contenu</a>
  <header class="top">
    <div class="wrap">
      <a href="/"><img src="/img/logo.png" alt={site.name} height="48" /></a>
      <button class="burger" aria-expanded="false" aria-controls="menu" id="burger">Menu</button>
      <nav id="menu" aria-label="Navigation principale">
        <ul>
          {nav.map((n) => (
            <li class={n.children?.length ? 'sub' : undefined}>
              <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
              {n.children?.length ? <ul>{n.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}</ul> : null}
            </li>
          ))}
          <li><BookButton /></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer>
    <div class="wrap">
      <div class="grid">
        <div><h3>{site.name}</h3><p>{site.address}<br />À 15 minutes du centre-ville.</p></div>
        <div><h3>Navigation</h3><ul>{footerNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></div>
        <div><h3>Contact</h3><p><a href={`tel:${site.phoneHref}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={site.tripadvisor} rel="noopener" target="_blank">Avis Tripadvisor</a></p></div>
      </div>
      <p class="copy">© {new Date().getFullYear()} {site.name}</p>
    </div>
  </footer>
  <div class="lightbox" id="lb" role="dialog" aria-modal="true" aria-label="Photo agrandie"><button type="button" id="lb-x" aria-label="Fermer">×</button><img alt="" /></div>
  <script is:inline>
    (function () {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var b = document.getElementById('burger'), m = document.getElementById('menu'), hd = document.querySelector('header.top');
      b.addEventListener('click', function () { var o = m.classList.toggle('open'); b.setAttribute('aria-expanded', o); });

      // Révélation au scroll
      var sel = 'main h2,main .lead,main .card,main .price,main .thumbs img,main .bento img,main .gal img,main .tarif-table,main form,main ul.ticks';
      var els = [].slice.call(document.querySelectorAll(sel)).filter(function (e) { return !e.closest('.hero'); });
      if ('IntersectionObserver' in window && !reduce) {
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (e, i) { e.classList.add('rv'); e.style.setProperty('--d', ((i % 3) * 0.08) + 's'); io.observe(e); });
      }

      // Bascule de thème clair -> sombre
      var th = [].slice.call(document.querySelectorAll('[data-theme-section]'));
      if (th.length && 'IntersectionObserver' in window) {
        var on = new Set();
        var to = new IntersectionObserver(function (es) {
          es.forEach(function (e) { e.isIntersecting ? on.add(e.target) : on.delete(e.target); });
          document.body.dataset.theme = on.size ? 'dark' : 'light';
          var mt = document.querySelector('meta[name=theme-color]'); if (mt) mt.content = on.size ? '#1b1815' : '#faf7f2';
        }, { rootMargin: '-45% 0px -45% 0px' });
        th.forEach(function (e) { to.observe(e); });
      }

      // Hero : parallaxe et zoom amortis, diaporama en fondu
      var media = document.querySelector('.hero-media'), inner = document.querySelector('.hero .in');
      if (media && !reduce) {
        var cur = 0, tgt = 0, ticking = false;
        var tick = function () {
          cur += (tgt - cur) * 0.12;
          var p = Math.min(cur / innerHeight, 1.2);
          media.style.transform = 'translate3d(0,' + (cur * 0.22) + 'px,0) scale(' + (1 + p * 0.08) + ')';
          if (inner) { inner.style.opacity = Math.max(1 - p * 1.4, 0); inner.style.transform = 'translate3d(0,' + (cur * 0.12) + 'px,0)'; }
          if (Math.abs(tgt - cur) > 0.3) requestAnimationFrame(tick); else ticking = false;
        };
        addEventListener('scroll', function () { tgt = scrollY; hd.classList.toggle('scrolled', scrollY > 8); if (!ticking) { ticking = true; requestAnimationFrame(tick); } }, { passive: true });
        var imgs = [].slice.call(media.querySelectorAll('img'));
        if (imgs.length > 1) { var k = 0; setInterval(function () { imgs[k].classList.remove('on'); k = (k + 1) % imgs.length; imgs[k].classList.add('on'); }, 6000); }
      } else addEventListener('scroll', function () { hd.classList.toggle('scrolled', scrollY > 8); }, { passive: true });

      // Lightbox
      var lb = document.getElementById('lb'), li = lb.querySelector('img'), last;
      var close = function () { lb.classList.remove('open'); if (last) last.focus(); };
      document.addEventListener('click', function (e) {
        var t = e.target.closest && e.target.closest('.gal img,.bento img,.thumbs img');
        if (t) { li.src = t.currentSrc || t.src; li.alt = t.alt; last = t; lb.classList.add('open'); document.getElementById('lb-x').focus(); }
        else if (lb.classList.contains('open')) close();
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && lb.classList.contains('open')) close(); });
    })();
  </script>
</body>
</html>
