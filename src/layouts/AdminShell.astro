---
import '../styles/admin.css';
import { navFor } from '../lib/hotel/nav';
import { ROLE_LABEL, levelFor } from '../lib/hotel/permissions';

interface Props { title: string; active: string }
const { title, active } = Astro.props;
const user = Astro.locals.user!;
const items = navFor(user.role);
const current = items.find((i) => i.key === active);
const initial = (user.name || '?').trim().charAt(0).toUpperCase();
const showSite = levelFor(user.role, 'site') !== null;
Astro.response.headers.set('cache-control', 'no-store');
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title} | Lodge des Almadies</title>
</head>
<body>
  <header class="topbar">
    <div class="topbar-in">
      <span class="brand"><span class="mark" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9l9-6 9 6v12M9 21v-7h6v7"/></svg></span>Lodge des Almadies</span>
      <nav class="zones" aria-label="Zones">
        {showSite && <a href="/admin/">Site</a>}
        <a href="/admin/hotel/" aria-current="page">Services hôtel</a>
      </nav>
      <span class="who"><span class="av" aria-hidden="true">{initial}</span><span class="who-name">{user.name}</span><button class="sm" id="logout" type="button">Déconnexion</button></span>
    </div>
  </header>
  <main>
    <div class="page-head no-print">
      <div>
        <h1 class="page-title">{current?.label ?? title}</h1>
        {current && <p class="page-help">{current.help}</p>}
      </div>
      <div class="acct"><span class="av lg" aria-hidden="true">{initial}</span><div><b>{user.name}</b><span>{ROLE_LABEL[user.role]}</span></div></div>
    </div>
    <nav class="tabs" aria-label="Sections">
      {items.map((i) => (
        <a href={i.href} aria-current={i.key === active ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={i.icon} />{i.label}
        </a>
      ))}
    </nav>
    <slot />
  </main>
  <script>
    import '../client/hotel/shell';
  </script>
</body>
</html>
