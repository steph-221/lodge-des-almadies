---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Contact et réservation | Lodge des Almadies, Dakar" description="Contactez le Lodge des Almadies pour réserver : Route des Almadies, Dakar. Tél. (+221) 33 869 03 45.">
  <section class="page-hero"><img src="/img/g-reception.jpg" alt="" /><h1>Contact et réservation</h1></section>
  <section><div class="wrap grid g2">
    <div>
      <h2>Nous écrire</h2>
      <form action={`mailto:${site.email}`} method="post" enctype="text/plain">
        <label>Nom<input name="nom" required autocomplete="name" /></label>
        <label>E-mail<input type="email" name="email" required autocomplete="email" /></label>
        <label>Arrivée<input type="date" name="arrivee" /></label>
        <label>Départ<input type="date" name="depart" /></label>
        <label>Message<textarea name="message" rows="5" required></textarea></label>
        <button class="btn" type="submit">Envoyer</button>
      </form>
    </div>
    <div>
      <h2>Coordonnées</h2>
      <p>{site.address}</p>
      <p><a href={`tel:${site.phoneHref}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <iframe title="Plan d’accès" loading="lazy" style="border:0;width:100%;height:300px;border-radius:12px" src="https://www.openstreetmap.org/export/embed.html?bbox=-17.5190%2C14.7375%2C-17.5110%2C14.7425&amp;layer=mapnik&amp;marker=14.7399266%2C-17.5150638"></iframe>
      <p><a href={site.maps} target="_blank" rel="noopener">Itinéraire sur Google Maps</a></p>
      <p><a href={site.tripadvisor} target="_blank" rel="noopener">Voir les avis Tripadvisor</a></p>
    </div>
  </div></section>
</Base>
