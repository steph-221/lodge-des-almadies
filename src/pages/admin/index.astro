---
import '../../styles/admin.css';
import { adminConfigured, sessionConfigured } from '../../lib/auth';
import { dbConfigured } from '../../lib/db';

export const prerender = false;
const user = Astro.locals.user;
// Hors direction : l'espace hôtel est leur seul accès.
if (user && user.role !== 'direction') return Astro.redirect('/admin/hotel/');
const configured = sessionConfigured() && (adminConfigured() || dbConfigured());
const authed = user?.role === 'direction';
Astro.response.headers.set('cache-control', 'no-store');
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Administration | Lodge des Almadies</title>
</head>
<body>
{!configured && (
  <main><div class="card"><h1>Administration non configurée</h1>
  <p>Définir les variables d’environnement <code>SESSION_SECRET</code> (16 caractères minimum) et <code>ADMIN_PASSWORD</code> (accès de secours de la direction) ou <code>DATABASE_URL</code> (comptes du personnel), puis redémarrer le site.</p></div></main>
)}
{configured && !authed && (
  <div class="login card">
    <h1>Administration</h1>
    <form id="login">
      <label>Identifiant<input type="text" id="lg" autocomplete="username" autocapitalize="none" spellcheck="false" /></label>
      <label>Code ou mot de passe<input type="password" id="pw" autocomplete="current-password" required /></label>
      <p class="hint">Accès de secours de la direction : laisser l’identifiant vide.</p>
      <button class="btn" type="submit">Se connecter</button>
      <p id="msg" class="err" role="alert"></p>
    </form>
  </div>
  <script is:inline>
    document.getElementById('login').addEventListener('submit', async function (e) {
      e.preventDefault();
      var r = await fetch('/api/admin/login', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ login: document.getElementById('lg').value, password: document.getElementById('pw').value }) });
      var j = await r.json().catch(function () { return {}; });
      if (r.ok) return (location.href = j.next || '/admin/');
      document.getElementById('msg').textContent = j.error || 'Connexion impossible.';
    });
  </script>
)}
{configured && authed && (
  <>
    <header>
      <h1>Administration · Lodge des Almadies</h1>
      <nav class="zones" aria-label="Zones">
        <a href="/admin/" aria-current="page">Site</a>
        <a href="/admin/hotel/">Services hôtel</a>
      </nav>
      <span><a href="/" target="_blank" rel="noopener">Voir le site</a> · <button class="sm" id="logout">Déconnexion</button></span>
    </header>
    <main>
      <nav class="tabs" id="tabs" aria-label="Sections"></nav>
      <div id="view">Chargement…</div>
    </main>
    <div class="bar"><span id="msg" role="status"></span><span><button class="sm danger" id="reset">Revenir au contenu d’origine</button> <button class="btn" id="save">Enregistrer</button></span></div>
    <script is:inline src="/admin.js"></script>
  </>
)}
</body>
</html>
