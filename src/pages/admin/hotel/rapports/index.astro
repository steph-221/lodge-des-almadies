---
import AdminShell from '../../../../layouts/AdminShell.astro';
import { dbConfigured } from '../../../../lib/db';

export const prerender = false;
const error = dbConfigured() ? '' : 'La base de données n’est pas configurée (variable DATABASE_URL absente).';
---
<AdminShell title="Rapports" active="reports">
  <h2 style="margin-top:0">Rapports</h2>
  <p class="hint">Occupation, délais de traitement des demandes et des pannes, consommation d’articles. Des chiffres seulement, aucun nom de client.</p>
  {error && <div class="card err" role="alert">{error}</div>}
  {!error && (
    <div id="reports-app">
      <form id="r-form" class="card no-print">
        <div class="row">
          <label>Du<input id="r-from" type="date" required /></label>
          <label>Au<input id="r-to" type="date" required /></label>
        </div>
        <div class="acts">
          <button class="btn" type="submit">Afficher</button>
          <button class="btn secondary" type="button" data-days="7">7 jours</button>
          <button class="btn secondary" type="button" data-days="30">30 jours</button>
          <button class="btn secondary" type="button" data-days="90">90 jours</button>
        </div>
      </form>
      <p id="r-msg" role="status" class="hint"></p>
      <div id="r-out"></div>
    </div>
  )}
  <script>
    import '../../../../client/hotel/rapports';
  </script>
</AdminShell>
