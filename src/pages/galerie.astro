---
import Base from '../layouts/Base.astro';
import { getContent, imgSrc } from '../lib/content';
const { gallery, pageHeroes } = await getContent();
---
<Base title="Galerie | Lodge des Almadies, Dakar" description="Photos de l’hôtel, des chambres, du restaurant, de la piscine et des boutiques.">
  <section class="page-hero"><img src={imgSrc(pageHeroes.galerie)} alt="" /><h1>Galerie</h1></section>
  <section><div class="wrap bento">{gallery.map((g) => <img src={imgSrc(g.src)} alt={g.alt} loading="lazy" />)}</div></section>
</Base>
