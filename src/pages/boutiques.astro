---
import Base from '../layouts/Base.astro';
import { getContent, imgSrc } from '../lib/content';
const { boutiques } = await getContent();
---
<Base title="Boutiques | Lodge des Almadies, Dakar" description="Les boutiques du Lodge des Almadies : bijoux faits main, créateurs et produits africains.">
  <section class="page-hero"><img src={imgSrc(boutiques.heroImage)} alt="" /><h1>Boutiques</h1></section>
  <section><div class="wrap">
    <p class="lead">{boutiques.intro}</p>
    {boutiques.items.map((b) => (
      <article class="shop" style="margin:32px 0">
        <h2>{b.name}</h2>
        <p>{b.text}</p>
        {b.phone && <p><strong>Téléphone : <a href={`tel:${b.phone.replace(/[^+\d]/g, '')}`}>{b.phone}</a></strong></p>}
        <div class="gal">{b.images.map((i) => <img src={imgSrc(i)} alt={b.name} loading="lazy" />)}</div>
      </article>
    ))}
  </div></section>
</Base>
