---
import Base from '../layouts/Base.astro';
import BookButton from '../components/BookButton.astro';
import { getContent, imgSrc } from '../lib/content';
const { home } = await getContent();
const slides = home.carousel.length ? home.carousel : [home.heroImage];
---
<Base title="Lodge des Almadies | Hôtel Dakar | Restaurant | Séminaires | Piscine">
  <section class="hero">
    <img src={imgSrc(slides[0])} alt="" fetchpriority="high" id="hero-img" data-slides={JSON.stringify(slides.map(imgSrc))} />
    <div class="in">
      <h1>{home.title}</h1>
      <p>{home.subtitle}</p>
      <BookButton />
    </div>
  </section>
  <section>
    <div class="wrap center">
      <h2>{home.welcomeTitle}</h2>
      <p class="lead">{home.welcomeText}</p>
    </div>
  </section>
  <section class="alt">
    <div class="wrap">
      <h2 class="center">Nos services</h2>
      <div class="grid g3">
        {home.services.map((s) => (
          <a class="card" href={s.href}><img src={imgSrc(s.img)} alt={s.title} loading="lazy" /><div class="b"><h3>{s.title}</h3><p>{s.text}</p></div></a>
        ))}
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      var el = document.getElementById('hero-img');
      if (!el) return;
      var s = JSON.parse(el.getAttribute('data-slides') || '[]'), i = 0;
      if (s.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      setInterval(function () { i = (i + 1) % s.length; el.src = s[i]; }, 5000);
    })();
  </script>
</Base>
