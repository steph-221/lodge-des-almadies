---
import Base from '../layouts/Base.astro';
import BookButton from '../components/BookButton.astro';
import { getContent, imgSrc } from '../lib/content';
const { home } = await getContent();
const webp = (u: string) => (/^\/img\/.+\.jpg$/.test(u) ? u.replace(/\.jpg$/, '.webp') : null);
const slides = home.carousel.length ? home.carousel : [home.heroImage];
---
<Base title="Lodge des Almadies | Hôtel Dakar | Restaurant | Séminaires | Piscine">
  <section class="hero">
    <div class="hero-media">
      {slides.map((sl, i) => <picture>{webp(imgSrc(sl)) && <source srcset={webp(imgSrc(sl))!} type="image/webp" />}<img src={imgSrc(sl)} alt="" class={i === 0 ? 'on' : undefined} fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></picture>)}
    </div>
    <div class="in">
      <h1>{home.title}</h1>
      <p>{home.subtitle}</p>
      <BookButton />
    </div>
  </section>
  <section>
    <div class="wrap center">
      <h2>{home.welcomeTitle}</h2>
      <p class="lead">{home.welcomeText}</p>
    </div>
  </section>
  <section class="dark-sec" data-theme-section>
    <div class="wrap">
      <h2 class="center">Nos services</h2>
      <div class="grid g3">
        {home.services.map((s) => (
          <a class="card" href={s.href}><img src={imgSrc(s.img)} alt={s.title} loading="lazy" /><div class="b"><h3>{s.title}</h3><p>{s.text}</p></div></a>
        ))}
      </div>
    </div>
  </section>
</Base>
