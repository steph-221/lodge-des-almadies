---
import Base from '../../layouts/Base.astro';
import BookButton from '../../components/BookButton.astro';
import { getContent, imgSrc, fmtFcfa, fmtEur } from '../../lib/content';
import { equipmentFor, getPublicTypes, pricesFor, summaryFor } from '../../lib/public-rooms';
const { slug } = Astro.params;
const c = await getContent();
const r = c.rooms.find((x) => x.slug === slug);
if (!r) return new Response(null, { status: 404 });
// Prix du back-office Chambres quand la base répond ; sinon, ceux du contenu de l'admin.
const db = await getPublicTypes();
const eq = db ? equipmentFor(r.slug, db) : null;
const sum = db ? summaryFor(r.slug, db) : null;
const litSup = db?.find((x) => x.extraBed != null)?.extraBed ?? c.tarifs.litSup ?? null;
const prices = ((db && pricesFor(r.slug, db)) ?? r.prices).map((p) => ({ label: p.label, fcfa: fmtFcfa(p.fcfa), eur: fmtEur(p.fcfa, c.rate), raw: p.fcfa }));
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'HotelRoom',
  name: r.name,
  description: r.intro,
  bed: { '@type': 'BedDetails', typeOfBed: sum?.beds ?? r.beds },
  occupancy: { '@type': 'QuantitativeValue', maxValue: 3 },
  image: r.images.map((i) => new URL(imgSrc(i), 'https://lodgedesalmadies.com').href),
  amenityFeature: (eq ? eq.all : r.equipment).map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
  containedInPlace: { '@id': 'https://lodgedesalmadies.com/#hotel' },
  makesOffer: prices.map((p) => ({ '@type': 'Offer', name: p.label, priceCurrency: 'XOF', price: String(p.raw) })),
}];
---
<Base title={`${r.name} | Lodge des Almadies, Dakar`} description={r.intro.slice(0, 155)} schema={schema}>
  <section class="page-hero"><img src={imgSrc(r.images[0] ?? 'hotel')} alt="" /><h1>{r.name}</h1></section>
  <section>
    <div class="wrap">
      <p class="lead">{r.intro}</p>
      <p class="center"><strong>{sum?.guests ?? r.guests}</strong> · {sum?.beds ?? r.beds} · 1 nuit minimum</p>
      <div class="grid g3 thumbs" style="margin:32px 0">
        {r.images.map((i) => <img src={imgSrc(i)} alt={r.name} loading="lazy" />)}
      </div>
      <div class="grid g2">
        <div>
          <h2>Équipements</h2>
          <ul class="ticks one">{(eq ? eq.all : r.equipment).map((e) => <li>{e}</li>)}</ul>
          {eq && eq.some.length > 0 && <><h3>Selon la chambre</h3><ul class="ticks one">{eq.some.map((e) => <li>{e}</li>)}</ul></>}
        </div>
        <div class="pin"><h2>Tarifs par nuit</h2>
          {prices.map((p) => <div class="price"><span>{p.label}</span><strong class="amt">{p.fcfa} <small>{p.eur}</small></strong></div>)}
          <p><small>{litSup != null && <>Lit supplémentaire : {fmtFcfa(litSup)} par nuit. </>}Taxe de séjour : {fmtFcfa(c.tarifs.taxeSejour)} par nuitée et par personne. Navette taxi aéroport disponible en supplément.</small></p>
          <BookButton />
        </div>
      </div>
    </div>
  </section>
</Base>
