---
import { getContent } from '../lib/content';
interface Props { class?: string; }
const { class: cls = 'btn' } = Astro.props;
const { booking } = await getContent();
// Tant que la réservation Octorate n'est pas activée dans /admin, le bouton mène au formulaire de contact.
const octorate = booking.enabled && /^https:\/\//.test(booking.url);
---
{octorate
  ? <a class={cls} href={booking.url} target="_blank" rel="noopener">Réserver</a>
  : <a class={cls} href="/contact/">Réserver</a>}
